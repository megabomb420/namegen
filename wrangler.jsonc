{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namegen",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Integer-string namespace id, unique per Cloudflare account. "1001" is the
      // documentation default and is simulated locally by `wrangler dev`; pick your
      // own integer if you deploy several rate-limited Workers under one account.
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    "CORS_ORIGINS": "https://megabomb420.github.io"
  }
}
