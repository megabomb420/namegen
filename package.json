{
  "name": "namegen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Music naming PWA — standalone v0.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:api": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "fixtures": "vitest run --config vitest.fixtures.config.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "workerd@1.20260903.1": true
  }
}
